# ==============================================================================
# PayFire Backend Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME=PayFire
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Port & Server (Render automatically supplies $PORT, default 8000)
PORT=8000

# Database Configuration
# Local SQLite default: sqlite:///./payfire.db
# Render PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./payfire.db

# In-Memory or Managed Redis (Optional, in-memory used if omitted)
# REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (Optional: synthetic sandbox engine used if omitted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Reasoning Providers (Optional: deterministic 6-agent math engine used if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Safety Guardrails
MAX_RETRY_ATTEMPTS=3
HIGH_VALUE_THRESHOLD_INR=10000.0
CONFIDENCE_THRESHOLD=0.75
RETRY_COOLDOWN_SECONDS=60
SECONDARY_ROUTE_CIRCUIT_BREAKER_FAIL_RATE=0.25

# CORS Allowed Origins (comma-separated if configured via environment or list)
# e.g., https://payfire.vercel.app, https://payfire.onrender.com
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
