# ==============================================================================
# PayFire Environment Configuration Template
# Copy this file to .env and provide your deployment-specific variables.
# ==============================================================================

# Core Application Settings
APP_NAME=PayFire
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server & Port
PORT=8000

# Database Configuration (SQLite default for zero-friction local run, or PostgreSQL for production)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/payfire
DATABASE_URL=sqlite:///./payfire.db

# Redis URL (Optional: in-memory cache used if omitted)
# REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (Optional: synthetic sandbox used if omitted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Reasoning Providers (Optional: deterministic 6-agent math engine used if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Safety Guardrails (Deterministic Policy Parameters)
MAX_RETRY_ATTEMPTS=3
HIGH_VALUE_THRESHOLD_INR=10000.0
CONFIDENCE_THRESHOLD=0.75
RETRY_COOLDOWN_SECONDS=60
SECONDARY_ROUTE_CIRCUIT_BREAKER_FAIL_RATE=0.25

# CORS Allowed Origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Environment Variable
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
